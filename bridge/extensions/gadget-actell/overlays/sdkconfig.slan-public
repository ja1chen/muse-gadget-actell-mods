# Public compile validation only: no account, Wi-Fi credentials, or signing key.
CONFIG_GADGET_SDK_TOKEN=""
CONFIG_HOMEHUB_WIFI_SSID=""
CONFIG_HOMEHUB_WIFI_PASSWORD=""
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
CONFIG_HOMEHUB_TUNNEL=n
CONFIG_ACTELL_BRIDGE=y
CONFIG_ACTELL_BRIDGE_IMAGES=y
CONFIG_ACTELL_BRIDGE_AVATAR_ACTIVITY=y
CONFIG_ACTELL_BRIDGE_USB_SETUP=n
