+/* At most 1023 UTF-8 bytes per request, preferably ending at punctuation. */
+static bool start_tts_segment(void)
+{
+    const char *full = s_turn.texts + s_turn.tts_msg * TEXT_MAX;
+    const char *text = full + s_turn.tts_offset;
+    size_t n = strlen(text);
+    if (n > 1023) {
+        n = 1023;
+        while (n && ((unsigned char)text[n] & 0xc0) == 0x80) --n;
+        size_t boundary = 0;
+        for (size_t k = 0; k < n; ++k) {
+            if (text[k] == '.' || text[k] == '!' || text[k] == '?' || text[k] == '\n') boundary = k + 1;
+            if (k + 2 < n && (unsigned char)text[k] == 0xe3 &&
+                (unsigned char)text[k+1] == 0x80 && (unsigned char)text[k+2] == 0x82) boundary = k + 3;
+            if (k + 2 < n && (unsigned char)text[k] == 0xef &&
+                (unsigned char)text[k+1] == 0xbc &&
+                ((unsigned char)text[k+2] == 0x81 || (unsigned char)text[k+2] == 0x9f)) boundary = k + 3;
+        }
+        if (boundary >= n / 2) n = boundary;
+    }
+    char segment[1024];
+    memcpy(segment, text, n);
+    segment[n] = '\0';
+    if (!n || !doubao_tts_start(segment)) return false;
+    s_turn.tts_offset += n;
+    return true;
+}
+#endif
