@@ -91,6 +102,27 @@
 void muse_state_set_level(float level)
 {
     s_level = level < 0 ? 0 : (level > 1 ? 1 : level);
+    float observer_level = isfinite(level) ? fminf(fmaxf(level, 0), 1) : 0;
+    portENTER_CRITICAL(&s_mouth_lock);
+    if (s_mouth_sample.speaking) {
+        if (observer_level > s_mouth_sample.peak) {
+            s_mouth_sample.peak = observer_level;
+        }
+        if (observer_level > 0.02f) {
+            s_mouth_sample.last_voice_us = esp_timer_get_time();
+            s_mouth_sample.heard_voice = true;
+        }
+    }
+    portEXIT_CRITICAL(&s_mouth_lock);
+}
+
+muse_mouth_sample_t muse_state_take_mouth_sample(void)
+{
+    portENTER_CRITICAL(&s_mouth_lock);
+    muse_mouth_sample_t sample = s_mouth_sample;
+    s_mouth_sample.peak = 0;
+    portEXIT_CRITICAL(&s_mouth_lock);
+    return sample;
 }
 
