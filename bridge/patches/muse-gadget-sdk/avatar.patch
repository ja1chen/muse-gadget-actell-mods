 void muse_state_set_mode(muse_mode_t mode)
 {
+    portENTER_CRITICAL(&s_mouth_lock);
     if (mode == s_mode) {
+        portEXIT_CRITICAL(&s_mouth_lock);
         return;
     }
     /* Shutting down wins over the voice pipeline finishing a turn. */
     if (s_mode == MUSE_MODE_OFF && mode != MUSE_MODE_IDLE) {
+        portEXIT_CRITICAL(&s_mouth_lock);
         return;
     }
+    s_mouth_sample = (muse_mouth_sample_t){
+        .generation = s_mouth_sample.generation + 1u,
+        .speaking = mode == MUSE_MODE_SPEAKING,
