+/* Keep the legacy poll API unchanged for other boards. */
+esp_err_t muse_pmu_poll_key_checked(unsigned *events)
+{
+    *events = 0;
+    if (!s_dev) return ESP_ERR_INVALID_STATE;
+    uint8_t sts;
+    esp_err_t err = rd(REG_INTSTS2, &sts);
+    if (err != ESP_OK) return err;
+    sts &= PKEY_ALL;
+    if (sts) {
+        err = wr(REG_INTSTS2, sts);
+        if (err != ESP_OK) return err; /* never deliver an unacknowledged event */
+    }
+    if (sts & PKEY_NEG_EDGE) *events |= MUSE_PMU_KEY_PRESS;
+    if (sts & PKEY_POS_EDGE) *events |= MUSE_PMU_KEY_RELEASE;
+    if (sts & PKEY_SHORT) *events |= MUSE_PMU_KEY_CLICK;
+    if (sts & PKEY_LONG) *events |= MUSE_PMU_KEY_LONG;
+    return ESP_OK;
+}
+
+esp_err_t muse_pmu_key_long_1500ms(void)
+{
+    if (!s_dev) return ESP_ERR_INVALID_STATE;
+    uint8_t value, check;
+    ESP_RETURN_ON_ERROR(rd(REG_IRQ_LEVEL, &value), TAG, "read key timing");
+    /* Datasheet REG27: [5:4]=01 is 1.5s IRQ; preserve ONLEVEL and 10s OFFLEVEL. */
+    value = (value & ~0x30) | 0x10;
+    ESP_RETURN_ON_ERROR(wr(REG_IRQ_LEVEL, value), TAG, "set key timing");
+    ESP_RETURN_ON_ERROR(rd(REG_IRQ_LEVEL, &check), TAG, "verify key timing");
+    return (check & 0x3F) == (value & 0x3F) && (check & 0x0C) == PKEY_OFF_10S
+           ? ESP_OK : ESP_ERR_INVALID_STATE;
+}
