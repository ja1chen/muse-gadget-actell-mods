# Compile profile only; verify exact module, GPIOs and partition layout before flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_MUSE_ENABLED=n
CONFIG_HOMEHUB_VOICE=n
CONFIG_MUSE_HEADLESS=y
CONFIG_MUSE_HEADLESS_HTTP_DEBUG=n
CONFIG_HOMEHUB_LED_BACKEND_NONE=y
CONFIG_HOMEHUB_TUNNEL=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
